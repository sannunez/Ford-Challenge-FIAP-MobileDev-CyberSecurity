# Docker Compose / local development
# Copy this file to .env and replace the development-only values.
PORT=8080
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=3600000
JWT_APP_KEY=ford-challenge-development-key

# Comma-separated origins accepted by Spring when the API is called from a browser.
CORS_ALLOWED_ORIGIN_PATTERNS=http://10.0.2.2:*,http://localhost:*,http://127.0.0.1:*

# Variables prefixed with EXPO_PUBLIC_ are embedded in the mobile application.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
EXPO_PUBLIC_APP_KEY=ford-challenge-development-key

# Android Emulator reaches the Windows host through 10.0.2.2.
# For a physical device, replace this with the computer's LAN IP.
EXPO_HOST_IP=10.0.2.2

